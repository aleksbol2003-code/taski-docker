# docker-compose.production.yml

volumes:
  pg_data:
  static_volume:

# Всё отличие — заменяем build на image и указываем, какой образ использовать
services:
  db:
    image: postgres:13.10
    env_file: .env
    volumes:
      - pg_data:/var/lib/postgresql/data
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U ${POSTGRES_USER} -d ${POSTGRES_DB}"]
      interval: 5s
      timeout: 5s
      retries: 10
      start_period: 30s

  backend:
#    image: aleksbol2003/taski_backend # Качаем с Docker Hub
    # Из какого Dockerfile собирать образ для этого контейнера:
    build: ./backend/
    env_file: .env
    volumes:
      - static_volume:/backend_static
    depends_on:
      db:
        condition: service_healthy
    # Важно: не запускай здесь runserver. Пусть образ стартует так, как заложено в ENTRYPOINT/CMD.
    # Если внутри образа уже есть gunicorn/uwsgi — этого достаточно.

  frontend:
#    image: aleksbol2003/taski_frontend  # Качаем с Docker Hub
    env_file: .env
    # Из какого Dockerfile собирать образ для этого контейнера:
    build: ./frontend/
#    command: cp -r /app/build/. /frontend_static/
#    volumes:
#      - static_volume:/frontend_static

  gateway:
#    image: aleksbol2003/taski_gateway  # Качаем с Docker Hub
#    env_file: .env
    # Сбилдить и запустить образ, 
    # описанный в Dockerfile в папке gateway
    build: ./gateway/
    volumes:
      - static_volume:/staticfiles/
    # Ключ ports устанавливает
    # перенаправление всех запросов с порта 8000 хоста
    # на порт 80 контейнера
    ports:
      - 8000:80
    depends_on:
      backend:
        condition: service_started
      db:
        condition: service_healthy
